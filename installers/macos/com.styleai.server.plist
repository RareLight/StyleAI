<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.styleai.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/StyleAI/Server/styleai-server</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Library/Logs/StyleAI/service.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Logs/StyleAI/service.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>KMP_DUPLICATE_LIB_OK</key>
        <string>TRUE</string>
    </dict>
</dict>
</plist>
